<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUI3RisohEditor.Views.DialogEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUI3RisohEditor.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar for dialog editor -->
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
            <AppBarButton Icon="Add" Label="Add Control" Click="AddControl_Click"/>
            <AppBarButton Icon="Delete" Label="Delete" Click="DeleteControl_Click"/>
            <AppBarSeparator/>
            <AppBarButton Icon="AlignLeft" Label="Align Left" Click="AlignLeft_Click"/>
            <AppBarButton Icon="AlignCenter" Label="Align Center" Click="AlignCenter_Click"/>
            <AppBarButton Icon="AlignRight" Label="Align Right" Click="AlignRight_Click"/>
            <AppBarSeparator/>
            <AppBarButton Icon="View" Label="Test Dialog" Click="TestDialog_Click"/>
        </CommandBar>

        <!-- Split view: Canvas and Properties -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="300" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <!-- Dialog Canvas -->
            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid Padding="20">
                    <Border x:Name="DialogCanvas"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="2"
                            MinWidth="200"
                            MinHeight="150"
                            Width="400"
                            Height="300">
                        <Grid>
                            <TextBlock Text="Dialog Preview Area"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource SystemControlDisabledBaseMediumLowBrush}"/>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- Splitter -->
            <Border Grid.Column="1" Width="4" Background="Transparent"/>

            <!-- Properties Panel -->
            <Grid Grid.Column="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Properties" FontWeight="SemiBold" Margin="12,8"/>

                <ScrollViewer Grid.Row="1">
                    <StackPanel Padding="12" Spacing="12">
                        <TextBlock Text="Dialog Properties" FontWeight="SemiBold"/>
                        
                        <TextBox x:Name="DialogIdTextBox" Header="ID" PlaceholderText="IDD_DIALOG"/>
                        <TextBox x:Name="DialogCaptionTextBox" Header="Caption" PlaceholderText="Dialog Title"/>
                        
                        <TextBlock Text="Size and Position" FontWeight="SemiBold" Margin="0,12,0,0"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            
                            <NumberBox Grid.Row="0" Grid.Column="0" Header="X" Value="0" SpinButtonPlacementMode="Compact"/>
                            <NumberBox Grid.Row="0" Grid.Column="1" Header="Y" Value="0" SpinButtonPlacementMode="Compact"/>
                            <NumberBox Grid.Row="1" Grid.Column="0" Header="Width" Value="400" SpinButtonPlacementMode="Compact"/>
                            <NumberBox Grid.Row="1" Grid.Column="1" Header="Height" Value="300" SpinButtonPlacementMode="Compact"/>
                        </Grid>

                        <TextBlock Text="Dialog Styles" FontWeight="SemiBold" Margin="0,12,0,0"/>
                        <CheckBox Content="Caption" IsChecked="True"/>
                        <CheckBox Content="System Menu" IsChecked="True"/>
                        <CheckBox Content="Minimize Box" IsChecked="False"/>
                        <CheckBox Content="Maximize Box" IsChecked="False"/>
                        <CheckBox Content="Resizable" IsChecked="False"/>
                        
                        <ComboBox Header="Font" SelectedIndex="0" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="MS Shell Dlg"/>
                            <ComboBoxItem Content="Segoe UI"/>
                            <ComboBoxItem Content="Arial"/>
                            <ComboBoxItem Content="Courier New"/>
                        </ComboBox>
                        
                        <NumberBox Header="Font Size" Value="8" SpinButtonPlacementMode="Compact"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
