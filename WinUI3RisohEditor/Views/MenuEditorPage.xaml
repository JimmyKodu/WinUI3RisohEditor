<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUI3RisohEditor.Views.MenuEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUI3RisohEditor.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
            <AppBarButton Icon="Add" Label="Add Item" Click="AddMenuItem_Click"/>
            <AppBarButton Icon="AddRemote" Label="Add Submenu" Click="AddSubmenu_Click"/>
            <AppBarButton Icon="Delete" Label="Delete" Click="DeleteMenuItem_Click"/>
            <AppBarSeparator/>
            <AppBarButton Icon="Up" Label="Move Up" Click="MoveUp_Click"/>
            <AppBarButton Icon="Down" Label="Move Down" Click="MoveDown_Click"/>
            <AppBarSeparator/>
            <AppBarButton Icon="View" Label="Test Menu" Click="TestMenu_Click"/>
        </CommandBar>

        <!-- Menu Structure and Properties -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="300" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <!-- Menu Tree View -->
            <Grid Grid.Column="0" Padding="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Menu Structure" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <TreeView Grid.Row="1" x:Name="MenuTreeView" SelectionMode="Single">
                    <TreeView.ItemTemplate>
                        <DataTemplate>
                            <TreeViewItem ItemsSource="{Binding SubItems}">
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon Glyph="&#xE700;" FontSize="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Text}"/>
                                    <TextBlock Text="{Binding IdText}" Margin="8,0,0,0" 
                                             Foreground="{ThemeResource SystemControlDisabledBaseMediumLowBrush}"/>
                                </StackPanel>
                            </TreeViewItem>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>

            <!-- Splitter -->
            <Border Grid.Column="1" Width="4" Background="Transparent"/>

            <!-- Properties Panel -->
            <Grid Grid.Column="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Menu Item Properties" FontWeight="SemiBold" Margin="12,8"/>

                <ScrollViewer Grid.Row="1">
                    <StackPanel Padding="12" Spacing="12">
                        <TextBox x:Name="MenuItemTextBox" Header="Text" PlaceholderText="Menu item text"/>
                        <TextBox x:Name="MenuItemIdBox" Header="ID" PlaceholderText="IDM_ITEM"/>
                        
                        <TextBlock Text="Item Flags" FontWeight="SemiBold" Margin="0,12,0,0"/>
                        <CheckBox Content="Checked" x:Name="CheckedCheckBox"/>
                        <CheckBox Content="Grayed" x:Name="GrayedCheckBox"/>
                        <CheckBox Content="Disabled" x:Name="DisabledCheckBox"/>
                        <CheckBox Content="Separator" x:Name="SeparatorCheckBox"/>
                        <CheckBox Content="Break" x:Name="BreakCheckBox"/>
                        <CheckBox Content="Bar Break" x:Name="BarBreakCheckBox"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
